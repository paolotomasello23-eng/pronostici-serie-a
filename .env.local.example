# Copia questo file in `.env.local` e riempi i valori.
# `.env.local` è in .gitignore e NON deve mai finire su GitHub.
# Il repository è pubblico: tutto ciò che sta qui dentro è un segreto vero.

# --- football-data.org (serve dalla milestone 3) ---
# Registrati su https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# --- Supabase (serve dalla milestone 2) ---
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypassa tutte le policy RLS: la usa SOLO il job di scoring lato server.
# Non deve mai raggiungere il browser, quindi niente prefisso NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard Supabase > Project Settings > API > JWT Settings > JWT Secret.
# Con questo firmiamo i token di sessione, così le policy RLS riconoscono
# i nostri utenti anche senza usare Supabase Auth.
SUPABASE_JWT_SECRET=

# --- Scheduler (serve dalla milestone 7) ---
# Stringa lunga e casuale a piacere: protegge gli endpoint di sync, che
# altrimenti sarebbero chiamabili da chiunque conosca l'URL.
CRON_SECRET=
